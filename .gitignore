# Source data files must remain local and must not be committed.
*.xlsx
*.xls

# Local environment and secrets
.env
.env.*
!.env.example

# Build and IDE artifacts
bin/
obj/
.vs/
.vscode/
__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
.tools/
artifacts/
*.py[cod]

