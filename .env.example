# Copy this file to .env before running Docker Compose.
# Replace the sample password before any shared or production deployment.
MSSQL_SA_PASSWORD=ChangeThis!Sap2026
MSSQL_PID=Developer
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

WEB_PORT=8080
WEB_UPLOAD_ENABLED=false
WEB_UPLOAD_MAX_BYTES=104857600

# Optional Stage 4 AI planning. Create a free API key at https://console.groq.com/keys.
# Keep disabled until AI_API_KEY is configured. Never commit the real key.
AI_ENABLED=false
AI_PROVIDER=Groq
AI_API_KEY=
AI_MODEL=llama-3.3-70b-versatile
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MAX_RECORDS=50
AI_TIMEOUT_SECONDS=30
AI_REQUESTS_PER_MINUTE=5

# This host path is mounted read-only inside the Python ETL Worker container.
SAP_SOURCE_PATH=./data/source
SAP_FILE_PATTERN=export*.xlsx
SAP_WORKSHEET_NAME=
# Metadata of the SAP export. These values are editable filters in the Web App.
SAP_PRODUCT=12
SAP_SALES_ORGANIZATION=SG50

# Daily schedule in ETL_TIMEZONE.
ETL_DAILY_TIME=01:00
ETL_TIMEZONE=Asia/Ho_Chi_Minh
ETL_MIN_FILE_AGE_SECONDS=10
# Enable only when every Excel file is a full snapshot for its Product/Sales Organization.
ETL_ENABLE_SOFT_DELETE=false
ETL_BATCH_SIZE=500
ETL_CONTROL_PORT=8090
# Normally false: the worker waits for the configured daily schedule.
ETL_RUN_ON_STARTUP=false
