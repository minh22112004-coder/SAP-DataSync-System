<Window x:Class="SapDataSync.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SAP DataSync Launcher"
        Width="880"
        Height="680"
        MinWidth="780"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackgroundBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#172554" Padding="28,22">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="SAP DataSync" Foreground="White" FontSize="25" FontWeight="Bold" />
                    <TextBlock Text="Trung tâm điều khiển hệ thống dữ liệu" Foreground="#C7D2FE" FontSize="14" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" x:Name="OverallStatusBadge" Background="#334155" CornerRadius="14" Padding="13,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="OverallStatusDot" Width="9" Height="9" Fill="#94A3B8" Margin="0,0,8,0" />
                        <TextBlock x:Name="OverallStatusText" Text="Đang kiểm tra" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="9" Padding="17" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Cơ sở dữ liệu" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                            <TextBlock Text="SQL Server" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="SqlStatusDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" />
                                <TextBlock x:Name="SqlStatusText" Text="Chưa xác định" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="9" Padding="17" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Giao diện và API" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                            <TextBlock Text="Web App" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="WebStatusDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" />
                                <TextBlock x:Name="WebStatusText" Text="Chưa xác định" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="White" CornerRadius="9" Padding="17" BorderBrush="#E2E8F0" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Đồng bộ dữ liệu" Foreground="{StaticResource MutedTextBrush}" FontSize="13" />
                            <TextBlock Text="ETL Worker" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,10" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="EtlStatusDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" />
                                <TextBlock x:Name="EtlStatusText" Text="Chưa xác định" Foreground="{StaticResource MutedTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" CornerRadius="9" Padding="20" Margin="0,20,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Điều khiển" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Bạn chỉ cần chọn thao tác mong muốn. Dữ liệu vẫn được giữ nguyên khi dừng hệ thống." Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,17" />
                        <WrapPanel>
                            <Button x:Name="StartButton" Content="▶  Khởi động hệ thống" Background="{StaticResource SuccessBrush}" Click="StartButton_Click" Margin="0,0,10,10" />
                            <Button x:Name="StopButton" Content="■  Dừng hệ thống" Background="{StaticResource DangerBrush}" Click="StopButton_Click" Margin="0,0,10,10" />
                            <Button x:Name="OpenWebButton" Content="↗  Mở Web App" IsEnabled="False" Click="OpenWebButton_Click" Margin="0,0,10,10" />
                            <Button x:Name="RefreshButton" Content="↻  Làm mới trạng thái" Background="#475569" Click="RefreshButton_Click" Margin="0,0,0,10" />
                        </WrapPanel>
                        <ProgressBar x:Name="BusyProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,7,0,0" />
                    </StackPanel>
                </Border>

                <Border Background="#0F172A" CornerRadius="9" Padding="18" Margin="0,20,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Thông báo" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock x:Name="LastUpdatedText" Text="" Foreground="#94A3B8" HorizontalAlignment="Right" FontSize="12" />
                        </Grid>
                        <TextBox x:Name="ActivityLog"
                                 Text="Launcher đã sẵn sàng."
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 Foreground="#CBD5E1"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="12.5"
                                 Height="105" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="28,11">
            <TextBlock x:Name="ProjectPathText" Text="Đang tìm cấu hình hệ thống…" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
